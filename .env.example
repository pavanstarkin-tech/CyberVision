# CyberVision Environment & Threat Intelligence API Configuration
# Copy this file to .env and populate your keys if available.
# Supports both raw strings and 'base64:<ENCODED_STRING>' format.
# The system runs with 100% functionality offline using cached intelligence if keys are blank.

ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
ALIENVAULT_OTX_API_KEY=your_alienvault_otx_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
GREYNOISE_API_KEY=your_greynoise_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# System Settings
CYBERVISION_ENV=development
CACHE_DB_PATH=data/cache/cti_cache.sqlite
DUCKDB_PATH=data/processed/cybervision_ecs.duckdb
LOG_LEVEL=INFO
